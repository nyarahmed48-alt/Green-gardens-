# Green Gardens — configuration.
#
# Copy this file to `.env` and fill in what you need. That is the filename the
# server reads: it calls dotenv.config() with no path, so `.env` is the only
# file loaded. On a hosting platform, set the same names in that platform's
# environment settings instead.
#
# Every .env file is git-ignored except this example, so a real key cannot be
# committed by accident.
#
# NOTHING HERE IS REQUIRED TO SEE THE SITE. Every page renders with no keys at
# all. The two systems behind it are separate and each says plainly that it is
# switched off rather than failing:
#
#   no OpenRouter key  → the concierge says it is not switched on yet
#   no mail settings   → the form says the desk is not connected
#
# Open /api/health on a running deployment to see which half is live.


# =============================================================================
# 1. THE AI CONCIERGE
# =============================================================================

# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model answers: https://openrouter.ai/models
# Anything ending ":free" costs nothing to call.
#
# Required, with no default on purpose. Model ids on aggregators get renamed
# and retired, and a stale hardcoded one fails as "model not found" — an error
# that points nowhere near the cause. Setting the key without this logs what to
# do and leaves the concierge switched off.
#
# Several ids may be listed, comma-separated, and are tried in order. Free
# models carry a daily cap; with one id, hitting it takes the concierge silent,
# and with two the site rides through it:
#
#   OPENROUTER_MODEL=vendor/model-a:free,vendor/model-b:free
OPENROUTER_MODEL=

# Optional. Point the calls at a proxy or a stand-in endpoint.
# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Optional. Your public URL, sent as the attribution header OpenRouter uses
# for its model rankings.
SITE_URL=


# =============================================================================
# 2. WHERE RESERVATIONS ARE EMAILED
# =============================================================================

# REQUIRED for reservations to work. The venue's own address — every booking
# lands here. Several addresses may be separated by commas.
MAIL_TO=

# The From address. Must be one your mail provider lets you send as, or the
# message is rejected or filed as spam. A display name is fine:
#   MAIL_FROM=Green Gardens <reservations@greengardens.iq>
# Defaults to SMTP_USER when left blank.
MAIL_FROM=

# Optional. Copied silently on every reservation.
MAIL_BCC=

# Send the guest their own confirmation when they gave an address. Default on.
MAIL_CONFIRM_GUEST=true

# Optional. Force a transport rather than letting one be chosen: smtp, resend,
# brevo or none. Left blank, an API key wins over SMTP, and "none" is what you
# get when nothing is configured.
MAIL_TRANSPORT=


# --- Option A: your own mail server (SMTP) -----------------------------------
#
# Works on Node hosts: local development, Render, Cloud Run, Vercel, Netlify.
# It does NOT work on Cloudflare Workers, which cannot open a socket — use
# option B there. Configure SMTP anyway and the endpoint says exactly that.
#
# Gmail and Outlook need an APP PASSWORD, not your normal login password.
#
#   Gmail    smtp.gmail.com       port 465, SMTP_SECURE=true
#   Outlook  smtp.office365.com   port 587, SMTP_SECURE=false
#   Zoho     smtp.zoho.com        port 465, SMTP_SECURE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# true  = implicit TLS from the first byte (port 465)
# false = start plain and upgrade with STARTTLS (port 587)
#
# Usually safe to leave blank: it defaults to true on port 465 and false
# everywhere else. Credentials are never sent over a connection that could not
# be encrypted — the send fails instead.
SMTP_SECURE=


# --- Option B: an HTTP mail API ----------------------------------------------
#
# Works on every host including Cloudflare Workers, and needs no socket. Set
# one of these and it is used in preference to SMTP.
#
# Resend: https://resend.com/api-keys — verify your sending domain first.
RESEND_API_KEY=

# Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
