# Green Gardens — configuration.
#
# Copy this file to `.env` and fill in what you need. That is the filename the
# server reads: it calls dotenv.config() with no path, so `.env` is the only
# file loaded. On a hosting platform, set the same names in that platform's
# environment settings instead.
#
# Every .env file is git-ignored except this example, so a real key cannot be
# committed by accident.
#
# NOTHING HERE IS REQUIRED TO SEE THE SITE. Every page renders with no keys at
# all. The two systems behind it are separate and each says plainly that it is
# switched off rather than failing:
#
#   no OpenRouter key  → Green AI says it is not switched on yet
#
# THE SITE VISIT FORM NEEDS NOTHING HERE. It posts to Netlify Forms, which
# captures submissions and emails them on — set up in the Netlify dashboard
# under Forms and Notifications, not in this file. There are no mail
# credentials in this project at all.
#
# Open /api/health on a running deployment to see what is live.


# =============================================================================
# 1. GREEN AI (the assistant, built and run by CoreOs)
# =============================================================================

# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model answers: https://openrouter.ai/models
# Anything ending ":free" costs nothing to call.
#
# Required, with no default on purpose. Model ids on aggregators get renamed
# and retired, and a stale hardcoded one fails as "model not found" — an error
# that points nowhere near the cause. Setting the key without this logs what to
# do and leaves Green AI switched off.
#
# Several ids may be listed, comma-separated, and are tried in order. Free
# models carry a daily cap; with one id, hitting it takes Green AI silent,
# and with two the site rides through it:
#
#   OPENROUTER_MODEL=vendor/model-a:free,vendor/model-b:free
OPENROUTER_MODEL=

# Optional. Point the calls at a proxy or a stand-in endpoint.
# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# Optional. Your public URL, sent as the attribution header OpenRouter uses
# for its model rankings.
SITE_URL=


# =============================================================================
# 2. WHAT GREEN AI READS (optional)
# =============================================================================
#
# Green AI already knows this site's content without any of this. It reads the
# page's own copy — services, rates, coverage, hours, the client quotes —
# straight from src/content.ts, so it can never fall out of step with what a
# visitor is reading.
#
# The crawler below is for pages that are NOT part of this site's content file:
# a portfolio, a price list, anything hosted elsewhere.
#
# A chat reply never waits on a crawl: a stale cache refreshes in the
# background and the answer goes out on what was already there.
#
# NOTE: pointing it at this site's own URL will not add anything. The page
# renders in the browser, so a crawler fetching it gets an app shell with no
# text in it. /api/health will tell you that rather than leaving you guessing.

# Comma-separated. Blank = the crawler is off.
#   CRAWL_URLS=https://example.com/portfolio,https://example.com/prices
CRAWL_URLS=

# Ceiling on pages per crawl — the URLs above plus what they link to, one level
# deep and same-origin only. Default 8, hard limit 25.
CRAWL_MAX_PAGES=8

# How long a crawl stands before it is fetched again. Default 60 minutes,
# minimum 5, maximum 1440 (a day).
CRAWL_TTL_MINUTES=60
